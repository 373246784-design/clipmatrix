<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=1080,height=1920"/>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:#050508}
    body{font-family:'Inter',-apple-system,sans-serif;color:#fff}
    video{display:block;object-fit:cover;width:100%;height:100%}
    .bd{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,0.45) 0%,rgba(0,0,0,0.15) 40%,rgba(0,0,0,0.08) 65%,rgba(0,0,0,0.30) 100%);z-index:5}
    .ol{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:50px 56px;pointer-events:none;z-index:10;text-align:center}
    .ol *{text-shadow:3px 3px 0 rgba(0,0,0,0.92),-3px -3px 0 rgba(0,0,0,0.92),3px -3px 0 rgba(0,0,0,0.92),-3px 3px 0 rgba(0,0,0,0.92),0 3px 0 rgba(0,0,0,0.92),3px 0 0 rgba(0,0,0,0.92),0 -3px 0 rgba(0,0,0,0.92),-3px 0 0 rgba(0,0,0,0.92),0 0 18px rgba(0,0,0,0.7)!important;font-weight:900!important}

    /* ── Hook ── */
    .hook-tag{font-size:22px;font-weight:800;color:#FFD700;letter-spacing:8px;text-transform:uppercase;margin-bottom:14px}
    .hook-line{font-size:64px;font-weight:900;line-height:1.08}
    .hook-sub{font-size:26px;font-weight:400;color:rgba(255,255,255,0.45);margin-top:14px;max-width:900px;line-height:1.3}

    /* ── Number Module ── */
    .num-step{font-size:16px;font-weight:700;color:#FFD700;letter-spacing:5px;text-transform:uppercase;margin-bottom:8px}
    .num-big{font-size:180px;font-weight:900;color:#FFD700;line-height:1;margin-bottom:4px}
    .num-label{font-size:34px;font-weight:800;color:#fff;margin-bottom:10px}
    .num-desc{font-size:24px;font-weight:400;color:rgba(255,255,255,0.55);max-width:880px;line-height:1.4}
    .num-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;max-width:880px}
    .num-tag{display:inline-block;padding:8px 16px;border:1px solid rgba(255,215,0,0.15);border-radius:22px;font-size:16px;color:#FFD700;text-shadow:none!important;font-weight:600}

    /* ── Bars Module ── */
    .bars-wrap{width:100%;max-width:880px}
    .bars-headline{font-size:52px;font-weight:900;color:#fff;line-height:1.08;margin-bottom:8px}
    .bars-sub{font-size:18px;font-weight:400;color:rgba(255,255,255,0.5);margin-bottom:18px;max-width:860px;line-height:1.35}
    .bar-row{display:flex;align-items:center;gap:16px;margin-bottom:12px}
    .bar-label{font-size:26px;font-weight:700;color:#fff;min-width:180px;text-align:right}
    .bar-track{flex:1;height:64px;background:rgba(255,255,255,0.04);border-radius:8px;overflow:hidden;position:relative}
    .bar-fill{height:100%;width:0%;border-radius:8px;position:absolute;left:0;top:0}
    .bar-fill-gold{background:#FFD700;box-shadow:0 0 8px rgba(255,215,0,0.3)}
    .bar-fill-cyan{background:linear-gradient(90deg,rgba(34,211,238,0.2),#22D3EE)}
    .bar-fill-gray{background:linear-gradient(90deg,rgba(255,255,255,0.08),rgba(255,255,255,0.2))}
    .bar-pct{font-size:32px;font-weight:900;color:#FFD700;min-width:85px;text-align:left}

    /* ── Donut Module ── */
    .donut-wrap{display:flex;align-items:center;gap:30px}
    .donut-ring{position:relative;width:180px;height:180px}
    .donut-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
    .donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
    .donut-pct{font-size:48px;font-weight:900;color:#FFD700;text-shadow:none!important;line-height:1}
    .donut-label{font-size:14px;font-weight:600;color:rgba(255,255,255,0.4);text-shadow:none!important;margin-top:2px}
    .donut-info{flex:1;display:flex;flex-direction:column;gap:8px}
    .donut-headline{font-size:44px;font-weight:900;color:#fff;line-height:1.08;margin-bottom:4px}
    .donut-sub{font-size:18px;font-weight:400;color:rgba(255,255,255,0.5);line-height:1.35;max-width:500px}
    .donut-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
    .donut-tag{display:inline-block;padding:5px 14px;border:1px solid rgba(255,215,0,0.15);border-radius:18px;font-size:14px;color:#FFD700;text-shadow:none!important;font-weight:600}

    /* ── Card Module (subtitle-style) ── */
    .card-tag{display:inline-block;padding:5px 14px;border:1px solid rgba(255,215,0,0.12);border-radius:16px;font-size:15px;color:#FFD700;text-shadow:none!important;font-weight:600}

    /* ── Breathe Module ── */
    .breathe-tag{font-size:16px;font-weight:600;color:rgba(255,215,0,0.35);letter-spacing:5px;text-transform:uppercase;text-shadow:2px 2px 0 rgba(0,0,0,0.8),-2px -2px 0 rgba(0,0,0,0.8)!important}

    /* ── CTA (底部) ── */
    .cta-wrap{position:absolute;left:50%;bottom:140px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:18px;pointer-events:none;z-index:100}
    .cta-btn{display:inline-block;padding:26px 64px;background:#25D366;border-radius:50px;font-size:34px;font-weight:800;color:#fff;box-shadow:0 0 60px rgba(37,211,102,0.18);position:relative;text-shadow:none!important}
    .cta-ring{position:absolute;top:-10px;left:-10px;right:-10px;bottom:-10px;border-radius:60px;border:2px solid rgba(37,211,102,0.25)}
    .brand-row{display:flex;align-items:center;gap:10px;padding:12px 26px;background:rgba(0,0,0,0.35);border-radius:30px;border:1px solid rgba(255,255,255,0.05)}
    .brand-dot{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#f7971e,#ffd200)}
    .brand-txt{font-size:20px;font-weight:700;color:#FFD700;text-shadow:none!important}

    /* ── 城市介绍专属: 数据格 ── */
    .data-row{display:flex;gap:12px;margin-top:14px;width:100%;max-width:860px;justify-content:center}
    .data-cell{flex:1;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.05);border-radius:14px;padding:12px;text-align:center}
    .data-num{font-size:28px;font-weight:900;color:#FFD700;line-height:1;text-shadow:none!important}
    .data-label{font-size:11px;font-weight:600;color:rgba(255,255,255,0.3);letter-spacing:1px;text-transform:uppercase;margin-top:4px;text-shadow:none!important}

    /* ── 进度条 ── */
    .prog-wrap{position:absolute;bottom:40px;left:56px;right:56px;height:3px;background:rgba(255,255,255,0.03);border-radius:3px;overflow:hidden;z-index:55}
    .prog-fill{height:100%;width:0%;background:linear-gradient(90deg,#FFD700,#FFD700);border-radius:3px;box-shadow:0 0 10px rgba(255,215,0,0.25)}

    /* ── Flight Path ── */
    .flight-row{display:flex;align-items:center;gap:0;margin-top:22px;width:620px;position:relative}
    .flight-city{font-size:22px;font-weight:700;color:rgba(255,255,255,0.45);text-shadow:none!important}
    .flight-line{flex:1;height:2px;background:linear-gradient(90deg,rgba(255,215,0,0.3),rgba(255,215,0,0.3));border-radius:2px;position:relative;margin:0 8px}
    .flight-plane{font-size:36px;position:absolute;top:-20px;left:30%;text-shadow:none!important;z-index:15}
  </style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{{TOTAL_DUR}}" data-width="1080" data-height="1920">

  {{VIDEO_TRACKS}}

  <!-- ════ 场景HTML（多模块引擎生成） ════ -->
  {{SCENES_HTML}}

  <!-- ════ 全局进度条 ════ -->
  <div id="prog-wrap" class="prog-wrap clip" data-start="0" data-duration="{{TOTAL_DUR}}"><div id="prog-fill" class="prog-fill"></div></div>

  <audio id="tts" data-start="0" data-duration="{{TTS_DUR}}" src="{{TTS_SRC}}" data-volume="1.0"></audio>
  <audio id="bgm" data-start="0" data-duration="{{TOTAL_DUR}}" src="{{BGM_SRC}}" data-volume="0.12"></audio>
</div>

<script>
window.__timelines = window.__timelines || {};
const tl = gsap.timeline({ paused: true, defaults: { ease: "power3.out" } });
{{SCENES_ANIMS}}
tl.to("#prog-fill",{width:"100%",duration:{{TOTAL_DUR}},ease:"none"},0.2);
tl.set({},{},{{TOTAL_DUR}});
window.__timelines["main"] = tl;
window.__hf = { duration: {{TOTAL_DUR}}, seek: function(t) { var tl = window.__timelines && window.__timelines["main"]; if (tl) tl.seek(t); } };
</script>
</body>
</html>
