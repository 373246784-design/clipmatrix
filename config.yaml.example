# Panda Workflow — 配置文件示例（已脱敏）
# 复制为 config.yaml 并填入你的真实值

# 账号范围
accounts:
  id_range: ["00", "01", "02", "03", "04"]

# API Keys（也可用环境变量）
api:
  deepseek:
    api_key: "sk-xxxxxxxx"         # 或 export DEEPSEEK_API_KEY
    base_url: "https://api.deepseek.com"
    model: "deepseek-v4-pro"
  metricool:
    api_url: "https://app.metricool.com/api"
    token: ""                      # 或 export METRICOOL_TOKEN
    user_id: ""                    # 或 export METRICOOL_USER_ID

# 飞书通知（可选，填了才能自动通知）
feishu:
  app_id: ""
  app_secret: ""
  open_id: ""

# 路径（相对于项目根目录）
paths:
  project_dir: ""
  output_dir: "output"
  library_dir: "library"
  workspace_dir: "workspace"
  config_dir: "config"
  templates_dir: "templates"
  sounds_dir: "sounds"

# 工作流参数
workflow:
  max_retries: 5
  retry_wait_sec: 2
  tts_max_duration_sec: 50
  qa_black_frame_threshold: 1.0

# 视频参数
video:
  min_words: 60
  max_words: 120
  output_format: "mp4"

# 内容方向
directions:
  - 成都
  - 重庆
  - 川西
